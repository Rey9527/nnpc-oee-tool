---
import SectionHeading from './SectionHeading.astro';
import type { IntagDeploymentCopy } from '../content/intag-deployment';

interface Props {
  copy: IntagDeploymentCopy;
}
const { copy } = Astro.props;
const variants = ['intag', 'ble'] as const;
---
<section id="deployment" class="container engineering-block">
  <SectionHeading title={copy.title} text={copy.intro} />
  <figure class="deployment-diagram">
    <h3>{copy.diagram.title}</h3>
    <div class="diagram-variants">
      {variants.map(variant => (
        <div class="diagram-variant">
          <h4>{copy[variant]}</h4>
          <svg viewBox="0 0 320 152" aria-hidden="true" focusable="false">
            <rect x="10" y="10" width="300" height="132" rx="4" fill="#fff" stroke="#8d9aa3" stroke-width="2" />
            <path d="M22 61h276M22 93h276" stroke="#d7dfe2" stroke-dasharray="4 4" />
            <g fill="#dae1e4" stroke="#afbbc1">
              <rect x="44" y="25" width="62" height="27" rx="2" />
              <rect x="127" y="25" width="62" height="27" rx="2" />
              <rect x="210" y="25" width="62" height="27" rx="2" />
              <rect x="44" y="103" width="62" height="25" rx="2" />
              <rect x="127" y="103" width="62" height="25" rx="2" />
              <rect x="210" y="103" width="62" height="25" rx="2" />
            </g>
            {variant === 'intag' ? (
              <g>
                <path d="M32 78h255V45" fill="none" stroke="#275f84" stroke-width="3" stroke-linecap="round" stroke-dasharray="7 5" />
                <circle cx="287" cy="45" r="8" fill="#ffcc00" stroke="#634e00" stroke-width="2" />
              </g>
            ) : (
              <g fill="#275f84" stroke="#fff" stroke-width="2">
                <rect x="30" y="54" width="12" height="12" rx="2" />
                <rect x="154" y="54" width="12" height="12" rx="2" />
                <rect x="278" y="54" width="12" height="12" rx="2" />
                <rect x="30" y="88" width="12" height="12" rx="2" />
                <rect x="154" y="88" width="12" height="12" rx="2" />
                <rect x="278" y="88" width="12" height="12" rx="2" />
              </g>
            )}
          </svg>
          <p>{copy.diagram[variant]}</p>
        </div>
      ))}
    </div>
    <figcaption>{copy.diagram.note}</figcaption>
  </figure>
  <div class="comparison">
    {copy.items.map(([topic, summary, intag, ble], index) => (
      <details open={index === 0}>
        <summary>
          <span><strong>{topic}</strong><span class="summary-text">{summary}</span></span>
          <span class="chevron" aria-hidden="true"></span>
        </summary>
        <dl>
          <div><dt>{copy.intag}</dt><dd>{intag}</dd></div>
          <div><dt>{copy.ble}</dt><dd>{ble}</dd></div>
        </dl>
      </details>
    ))}
  </div>
</section>

<style>
  .deployment-diagram { margin: 24px 0 0; border-top: 3px solid var(--yellow); padding-top: 16px; }
  h3, h4 { margin: 0; letter-spacing: 0; }
  h3 { font-size: 18px; }
  h4 { font-size: 14px; }
  .diagram-variants { display: grid; gap: 12px; margin-top: 12px; }
  .diagram-variant { min-width: 0; padding: 14px; background: var(--paper); border: 1px solid var(--line); }
  .diagram-variant svg { display: block; width: 100%; height: auto; margin-block: 8px; }
  .diagram-variant p, figcaption, .summary-text { color: var(--muted); font-size: 14px; line-height: 1.55; }
  .diagram-variant p { margin: 0; }
  figcaption { margin-top: 10px; }
  .comparison { margin-top: 20px; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 4px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid #725800; outline-offset: 2px; }
  .summary-text { display: block; margin-top: 3px; }
  .chevron { flex: 0 0 8px; height: 8px; border: solid currentColor; border-width: 0 2px 2px 0; transform: rotate(45deg); margin-right: 5px; }
  details[open] .chevron { transform: rotate(225deg); }
  dl { display: grid; gap: 12px; margin: 0; }
  details dl { padding-bottom: 14px; }
  dl > div { min-width: 0; padding: 14px; background: var(--paper); }
  dt { font-size: 14px; font-weight: 700; }
  dd { margin: 6px 0 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
  @media (min-width: 768px) {
    .diagram-variants, dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
