---
import SectionHeading from './SectionHeading.astro';
import type { intagDeploymentCopy } from '../content/intag-deployment';
import type { Locale } from '../content/home';

interface Props {
  copy: (typeof intagDeploymentCopy)[Locale];
}
const { copy } = Astro.props;
---
<section id="deployment" class="container engineering-block">
  <SectionHeading title={copy.title} text={copy.intro} />
  <div class="comparison">
    {copy.items.map(([topic, intag, ble]) => (
      <div class="comparison-row">
        <h3>{topic}</h3>
        <dl>
          <div><dt>{copy.intag}</dt><dd>{intag}</dd></div>
          <div><dt>{copy.ble}</dt><dd>{ble}</dd></div>
        </dl>
      </div>
    ))}
  </div>
</section>

<style>
  .comparison { margin-top: 24px; border-top: 3px solid var(--yellow); }
  .comparison-row { padding-block: 20px; border-bottom: 1px solid var(--line); }
  h3 { margin-bottom: 12px; font-size: 18px; letter-spacing: 0; }
  dl { display: grid; gap: 12px; margin: 0; }
  dl > div { min-width: 0; padding: 14px; background: var(--paper); }
  dt { font-size: 14px; font-weight: 700; }
  dd { margin: 6px 0 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
  @media (min-width: 768px) {
    .comparison-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 4fr);
      gap: 16px;
      align-items: start;
    }
    h3 { margin-top: 12px; }
    dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
