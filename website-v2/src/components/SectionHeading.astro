---
interface Props {eyebrow?:string; title:string; text?:string}
const {eyebrow,title,text}=Astro.props;
---
<div class="section-heading">{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h2>{title.split('<br/>').map((line,index)=><>{index>0 && <br/>}{line}</>)}</h2>{text && <p class="muted">{text}</p>}</div>
