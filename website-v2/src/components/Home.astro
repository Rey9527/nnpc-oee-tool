---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Button from './Button.astro';
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';
import ProjectCard from './ProjectCard.astro';
import CoverageMap from './CoverageMap.astro';
import Icon from './Icon.astro';
import type { Locale } from '../content/home';
import { capabilityIcons, contact, homeCopy, serviceIcons, solutionNames } from '../content/home-copy';
import { engineeringPath, engineeringServices, localizedPath, servicePath, solutionPath } from '../content/routes';
import { solutionIds } from '../content/company';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = homeCopy[locale];
const sceneImages = ['cctv-inspection', 'network-room', 'ahu-monitoring'];
---
<BaseLayout locale={locale}>
  <Header locale={locale} />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <img src="/images/home/home-hero-desktop.png" width="1774" height="887" alt={copy.hero.alt} fetchpriority="high" decoding="async" />
      <div class="hero-shade"></div>
      <div class="container hero-content">
        <p class="eyebrow hero-eyebrow">{copy.hero.eyebrow}<span></span></p>
        <h1 id="hero-title">{copy.hero.title}</h1>
        <p class="hero-description">{copy.hero.text}</p>
        <Button href="#contact">{copy.consult}</Button>
      </div>
    </section>

    <section class="services-coverage container" aria-label={copy.servicesCoverage}>
      <div id="services" class="services-panel">
        <SectionHeading title={copy.servicesTitle} text={copy.servicesText} />
        <div class="services-grid">
          {copy.services.map(([title, description], index) =>
            <ServiceCard title={title} description={description} icon={serviceIcons[index]} href={localizedPath(locale, servicePath(engineeringServices[index]))} />
          )}
        </div>
      </div>
      <CoverageMap locale={locale} />
    </section>

    <section class="capabilities" aria-labelledby="capabilities-title">
      <div class="container">
        <h2 id="capabilities-title" class="sr-only">{copy.capabilityTitle}</h2>
        <div class="capability-grid">
          {copy.capabilities.map(([title, description], index) => (
            <article>
              <Icon name={capabilityIcons[index]} />
              <div><h3>{title}</h3><p>{description}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="engineering" class="section container engineering-section">
      <div>
        <SectionHeading eyebrow={copy.engineering.eyebrow} title={copy.engineering.title} text={copy.engineering.text} />
        <Button href={localizedPath(locale, engineeringPath)} secondary>{copy.engineering.link}</Button>
      </div>
      <div class="engineering-detail" id="engineering-details">
        <h3>{copy.engineering.detail}</h3>
        <p>{copy.engineering.detailText}</p>
        <a class="text-link" href="#contact">{copy.consult} <span class="ui-symbol"><Icon name="arrow-right" /></span></a>
      </div>
      <div class="engineering-partnerships">
        <h3>{copy.engineering.partnershipTitle}</h3>
        <dl>
          {copy.engineering.partnerships.map(([title, description]) => (
            <div><dt>{title}</dt><dd>{description}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <section id="work" class="section projects-section">
      <div class="container">
        <div class="section-top">
          <SectionHeading eyebrow={copy.work.eyebrow} title={copy.work.title} text={copy.work.text} />
        </div>
        <div class="project-grid">
          {copy.work.scenes.map(([title, description], index) => (
            <ProjectCard image={sceneImages[index]} title={title} description={description} label={copy.work.label} />
          ))}
        </div>
      </div>
    </section>

    <section id="delivery" class="section container">
      <SectionHeading eyebrow={copy.delivery.eyebrow} title={copy.delivery.title} text={copy.delivery.text} />
      <ol class="process-grid">
        {copy.delivery.steps.map((step, index) => (
          <li><span class="step-number">0{index + 1}</span><h3>{step}</h3><span class="ui-symbol step-line"><Icon name="arrow-right" /></span></li>
        ))}
      </ol>
    </section>

    <section id="solutions" class="section solutions-section">
      <div class="container">
        <div class="section-top">
          <SectionHeading eyebrow={copy.solutions.eyebrow} title={copy.solutions.title} />
          <p class="solutions-intro">{copy.solutions.text}</p>
        </div>
        <div class="solution-list">
          {solutionIds.map((id, index) => (
            <a href={localizedPath(locale, solutionPath(id))}>
              <span class="solution-number" aria-hidden="true">0{index + 1}</span>
              <div class="solution-label">
                <h3>{solutionNames[index]}</h3>
                <p>{copy.solutions.subtitles[id]}</p>
              </div>
              <span class="ui-symbol"><Icon name="arrow-right" /></span>
            </a>
          ))}
        </div>
        <a class="text-link solutions-all" href={localizedPath(locale, 'solutions/')}>
          {copy.solutions.viewAll} <span class="ui-symbol"><Icon name="arrow-right" /></span>
        </a>
      </div>
    </section>

    <section id="industries" class="section container industries-section">
      <SectionHeading eyebrow={copy.industries.eyebrow} title={copy.industries.title} />
      <div>
        <p>{copy.industries.text}</p>
        <a class="text-link" href="#contact">{copy.industries.link} <span class="ui-symbol"><Icon name="arrow-right" /></span></a>
      </div>
    </section>

    <section id="about" class="about-section">
      <div class="container about-inner">
        <SectionHeading eyebrow={copy.about.eyebrow} title={copy.about.title} />
        <p>{copy.about.text}</p>
      </div>
    </section>

    <section id="contact" class="section container contact-section">
      <div>
        <p class="eyebrow">{copy.contact.eyebrow}</p>
        <h2>{copy.contact.title}</h2>
        <p>{copy.contact.text}</p>
      </div>
      <div class="contact-panel">
        <Button href={`mailto:${contact.email}`}>{copy.contact.email} · {contact.email}</Button>
        <Button href={contact.lineUrl} secondary>{`${copy.contact.line} ${contact.lineId}`}</Button>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
